{
  "name": "reqable-cli",
  "version": "1.0.1",
  "description": "Command-line front end for Reqable's local capture API: list, inspect, export and replay captured traffic without registering an MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsonist-g/reqable-skill.git"
  },
  "homepage": "https://github.com/arsonist-g/reqable-skill#readme",
  "bugs": {
    "url": "https://github.com/arsonist-g/reqable-skill/issues"
  },
  "author": "arsonist-g",
  "type": "module",
  "bin": {
    "reqable-cli": "bin/reqable-cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "SKILL.md",
    "skill-zh.md",
    "references/",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "e2e": "node test/e2e.mjs",
    "e2e:extra": "node test/e2e-extra.mjs",
    "check": "npm test && node test/e2e.mjs && node test/e2e-extra.mjs",
    "check:line": "node scripts/check-version-line.mjs",
    "prepublishOnly": "npm test && node scripts/check-version-line.mjs"
  },
  "keywords": [
    "reqable",
    "cli",
    "http",
    "capture",
    "proxy",
    "mitm",
    "agent",
    "skill"
  ],
  "dependencies": {},
  "reqable": {
    "supported": "3.2",
    "verifiedWith": "3.2.23",
    "note": "The Reqable release line this build was written against. src/reqable.js holds the same values as SUPPORTED_REQABLE and VERIFIED_REQABLE, and test/unit.test.mjs fails if the two disagree."
  }
}
